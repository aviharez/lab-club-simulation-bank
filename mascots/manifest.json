  "actor_conventions": {
    "format": "glTF 2.0 binary, Y-up, origin at the feet, height ~1.0 (scale in code), character faces +X: set rotation.y = -Math.PI / 2 to face a camera on +Z",
    "clips": "every clip is in place: horizontal travel and jump height come from code; loop=true clips have last frame == first frame (play with THREE.LoopRepeat)",
    "speed": "walk/run speed_units_per_s = ground speed that keeps the feet planted at height 1.0 (multiply by your scale)",
    "face": "swap expressions by setting face material .map AND .emissiveMap to the expression texture (texture.flipY = false, colorSpace = SRGBColorSpace); the face is lit dimly + emissive so it stays bright",
    "material": "MeshStandardMaterial: base color map + roughness, metalness 0; doubleSided"
  }
}